{
  "name": "unofficial-omarchy-app-store",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "for t in tests/*.test.mjs; do node --test \"$t\" || exit 1; done",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply omarchyapps --local",
    "migrate:remote": "wrangler d1 migrations apply omarchyapps --remote"
  },
  "devDependencies": {
    "wrangler": "4.137.0"
  }
}
